# ---------------------------------------------------------------------------
# CSMJU Internship Directory - frontend environment (คัดลอกเป็น .env.local)
# frontend ห้ามมี DATABASE_URL — ต้องคุยผ่าน backend เท่านั้น (ARC-01)
# ---------------------------------------------------------------------------

# NestJS backend ของระบบย่อยนี้ (ฝั่ง server เท่านั้น) — next.config.ts ส่ง
# /api/* /auth/login /auth/callback /auth/logout ต่อไปที่นี่
BACKEND_URL=http://127.0.0.1:4218

# ต้องตรงกับ name ใน Subsystem Registry, subsystem.yaml และ SUBSYSTEM_ID ของ backend
# ใช้ตั้งชื่อคุกกี้ session: csmju_internship_directory_access_token
SUBSYSTEM_ID=csmju-internship-directory

# หน้าเว็บ Core Hub (portal ที่ผู้ใช้ login) — ปุ่ม "กลับ CSMJU Portal" ใน CsmjuAppShell พาไปที่นี่
# ไม่ตั้ง = ไม่แสดงปุ่ม · ต้องเป็นค่าเดียวกับ CORE_HUB_WEB_URL ของ backend (ui-design-system.md ข้อ 5.1)
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
