{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "CSMJU Internship Directory - Next.js frontend, sign-in through Core Hub SSO only",
  "scripts": {
    "dev": "next dev -p 3218",
    "start:dev": "next dev -p 3218",
    "build": "next build",
