    "generate:api-types": "openapi-typescript ../backend/openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^1.51.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.9"
  }
}
