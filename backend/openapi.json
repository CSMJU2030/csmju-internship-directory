    "/auth/callback": {
      "get": {
        "operationId": "SsoController_callback",
        "parameters": [
          {
            "in": "query",
            "name": "access_token",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "token_type",
            "required": false,
            "schema": {
              "enum": [
                "Bearer",
                "bearer"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "expires_in",
            "required": false,
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Where Core Hub sends the browser with a token. The answers follow the\ntable of auth-contract 5.1, in its order:\n\n - no `access_token`: 400.\n - no `state`: Core Hub started this sign-in itself, e.g. a sidebar click.\n   The token is dropped unused and the browser restarts at /auth/login,\n   which comes back here with a state this subsystem can check. A link\n   carrying an attacker's token therefore signs the victim in as the\n   victim, never as the attacker.\n - a `state` without a matching state cookie: 401, and no redirect - if\n   the browser refuses cookies, redirecting again would loop forever. A\n   browser gets a page with a \"sign in again\" link instead of raw JSON.\n - a token that fails the ten checks: 401 · a role this subsystem does\n   not accept: 403.\n - otherwise the token becomes the session cookie and the browser goes\n   to the page it started from.\n\nNo failure sets the session cookie. The URL carries the access token, so\nit is never logged - only the path.",
        "tags": [
          "Sso"
        ]
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "SsoController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Starts a sign-in: mints a single-use state, keeps it (with the page to\nreturn to) in a cookie only the callback receives, and sends the browser\nto Core Hub's web app, which signs the user in or renews their session.\n\nNo callback_url is sent: Core Hub only ever redirects to the one in its\nregistry, and refuses a different one with 400.",
        "tags": [
          "Sso"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "SsoController_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Signs out everywhere. Dropping only this subsystem's cookies would be\nundone by the next click, which Core Hub - still signed in - would answer\nwith a fresh token. So the browser goes on to Core Hub's /logout, where\nthe user confirms ending the Core Hub session.\n\nPublic on purpose: it must work with an expired or missing session, and\nall it does is clear this subsystem's own cookies.",
        "tags": [
          "Sso"
        ]
      }
    }
